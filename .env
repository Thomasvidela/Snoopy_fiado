# ==============================================================================
# VARIABLES DE ENTORNO: Sistema de Cuentas Corrientes (Libreta de Fiados)
# ==============================================================================

# Nombre del proyecto
PROJECT_NAME="Despensa Snoopy - Libreta de Fiados"

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_password_segura_aqui
POSTGRES_DB=fiados

# URL de conexión (generada automáticamente en docker-compose, o manual si es local)
DATABASE_URL=postgresql+psycopg://postgres:cambiar_password_segura_aqui@localhost:5432/fiados

# Seguridad JWT (Generar con: openssl rand -hex 32)
JWT_SECRET=generar_clave_aleatoria_larga_para_jwt_produccion
JWT_ALGORITHM=HS256

# Duración del Token en minutos (129600 = 90 días, para no requerir login diario en celulares)
ACCESS_TOKEN_EXPIRE_MINUTES=129600

# Cloudflare Tunnel Token (Opcional - para acceso HTTPS remoto desde 4G/celulares)
# Obtener de: https://one.dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoiNGIxNDYzMTcwMDQ1YjU1NzQ1NGYyYWUyOGNlMmE1NzEiLCJ0IjoiNGU5YjUzNGEtNDdiMy00MmMxLThmODctY2VhN2MyMTE4Y2MxIiwicyI6Ik5ERXhOR1ZqWlRjdE16UmtOaTAwT1dZM0xUbGlZV1l0TWpCbVpHRmxNakJsT0RBMSJ9
